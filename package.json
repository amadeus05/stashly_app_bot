{
  "name": "note-keeper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "tsc --noEmit false --outDir .test-build --skipLibCheck && node tests/intent.mjs && node tests/capture.mjs && python tests/replay.py",
    "db:local": "wrangler d1 migrations apply note_keeper --local",
    "db:remote": "wrangler d1 migrations apply note_keeper --remote"
  },
  "dependencies": {
    "grammy": "^1.30.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240909.0",
    "typescript": "^5.6.0",
    "wrangler": "^3.78.0"
  }
}
