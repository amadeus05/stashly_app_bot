# Скопируйте в .env и подставьте свои значения.
# .env в git не попадает — там настоящий токен.
#
# WEBHOOK_SECRET и ADMIN_SECRET можно не заполнять:
# scripts/setup-secrets.ps1 сгенерирует их сам при первом запуске.
#
# В рантайме этот файл не используется — на Cloudflare секреты живут
# в `wrangler secret put`. .env нужен только скрипту деплоя.

# Токен от @BotFather
TG_API_TOKEN=123456789:AAExampleExampleExampleExampleExample

# Сверяется с заголовком Telegram, чтобы вебхук не мог дёрнуть посторонний.
# Только латиница, цифры, дефис и подчёркивание — требование Telegram.
WEBHOOK_SECRET=

# Защищает /admin/*
ADMIN_SECRET=
